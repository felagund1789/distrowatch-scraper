# Environment Configuration
NODE_ENV=development

# Scraping Settings
INDEX_URL=https://distrowatch.com/dwres.php?resource=popularity
DISTRO_URL=https://distrowatch.com/table.php?distribution=
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:146.0) Gecko/20100101 Firefox/146.0
REQUEST_DELAY=1000
MAX_RETRIES=3
TIMEOUT=10000

# Output Settings
OUTPUT_DIR=./data
OUTPUT_FILE=distros.json

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log